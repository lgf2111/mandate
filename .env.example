# PayPal sandbox (https://developer.paypal.com/dashboard/applications/sandbox)
# Leave both empty to run in demo mode: orders are simulated and labelled "demo".
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Optional: any OpenAI-compatible chat-completions endpoint.
# Without it the agent falls back to a deterministic keyword planner.
MANDATE_LLM_BASE_URL=
MANDATE_LLM_API_KEY=
MANDATE_LLM_MODEL=deepseek-v4.1-flash
# Set to 1 for gateways that route by session header (OpenCode Go answers 400
# MissingSessionID without one). Leave unset for a plain OpenAI-compatible API.
MANDATE_LLM_SESSION_HEADER=
# Milliseconds before the model call is abandoned and the deterministic planner
# answers instead. The response's "engine" field says which one actually ran.
MANDATE_LLM_TIMEOUT_MS=60000

PORT=8787
